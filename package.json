{
  "name": "kickbase-calculator",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "npm run format:check && npm run test:ci && ng build --configuration production",
    "build:prod-update": "npm run format:check && npm run test:ci && ng build --configuration production-update",
    "test": "ng test --watch=false --code-coverage",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless --code-coverage",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,css,json,md}\""
  },
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/platform-browser-dynamic": "22.2.4",
    "@angular/router": "22.2.4",
    "@angular/service-worker": "22.2.4",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.2",
    "marked": "18.1.2",
    "ngx-bootstrap": "22.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@types/jasmine": "6.0.0",
    "@types/node": "26.6.6",
    "istanbul-lib-instrument": "6.0.3",
    "jasmine-core": "6.3.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.3.0",
    "prettier": "3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "6.0.3"
  }
}
